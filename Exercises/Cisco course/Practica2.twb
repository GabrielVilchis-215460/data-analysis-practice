    <worksheet name='Hoja 2'>
      <layout-options>
        <title>
          <formatted-text>
            <run>¿Qué estudio de peliculas produjo más ingresos en el año 2010?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='HollywoodsMostProfitableStories' name='federated.1lnl23l115iv6m10xmeoy05xsi4x' />
          </datasources>
          <datasource-dependencies datasource='federated.1lnl23l115iv6m10xmeoy05xsi4x'>
            <column datatype='string' name='[Lead Studio]' role='dimension' type='nominal' />
            <column datatype='real' name='[Worldwide Gross]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
            <column-instance column='[Worldwide Gross]' derivation='Avg' name='[avg:Worldwide Gross:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Lead Studio]' derivation='None' name='[none:Lead Studio:nk]' pivot='key' type='nominal' />
            <column-instance column='[Year]' derivation='None' name='[none:Year:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1lnl23l115iv6m10xmeoy05xsi4x].[Inclusiones (Lead Studio,Year)]'>
            <groupfilter function='reorder-dimensionality' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='crossjoin'>
                <groupfilter function='member' level='[none:Year:qk]' member='2010' />
                <groupfilter function='union'>
                  <groupfilter function='member' level='[none:Lead Studio:nk]' member='&quot;CBS&quot;' />
                  <groupfilter function='member' level='[none:Lead Studio:nk]' member='&quot;Disney&quot;' />
                  <groupfilter function='member' level='[none:Lead Studio:nk]' member='&quot;Fox&quot;' />
                  <groupfilter function='member' level='[none:Lead Studio:nk]' member='&quot;Independent&quot;' />
                  <groupfilter function='member' level='[none:Lead Studio:nk]' member='&quot;Lionsgate&quot;' />
                  <groupfilter function='member' level='[none:Lead Studio:nk]' member='&quot;Paramount&quot;' />
                  <groupfilter function='member' level='[none:Lead Studio:nk]' member='&quot;Sony&quot;' />
                  <groupfilter function='member' level='[none:Lead Studio:nk]' member='&quot;Summit&quot;' />
                  <groupfilter function='member' level='[none:Lead Studio:nk]' member='&quot;The Weinstein Company&quot;' />
                  <groupfilter function='member' level='[none:Lead Studio:nk]' member='&quot;Universal&quot;' />
                  <groupfilter function='member' level='[none:Lead Studio:nk]' member='&quot;Warner Bros.&quot;' />
                </groupfilter>
              </groupfilter>
              <order>
                <hierarchy name='[none:Lead Studio:nk]' />
                <hierarchy name='[none:Year:qk]' />
